# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Базовый URL storefront для ссылок в письмах
WEB_URL=http://localhost:3002

# Database (PostgreSQL) — два варианта на выбор:
#
# Вариант 1: connection string (стандарт для Cloud — Neon/Supabase/Railway/Heroku)
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Вариант 2: отдельные переменные (default)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sports-shop

# Redis (опционально). Если не задан REDIS_HOST → email отправляется
# синхронно без очереди (без retry). Для prod рекомендуется включить.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# S3 storage (S3-compatible). Default — local MinIO.
# Раскомментируй один из preset'ов под свой провайдер:
#
# --- MinIO (local Docker, dev) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sports-shop
S3_REGION=us-east-1
# S3_PUBLIC_URL=http://localhost:9000/sports-shop
#
# --- AWS S3 ---
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=my-shop-media
# S3_REGION=eu-central-1
# S3_PUBLIC_URL=https://my-shop-media.s3.eu-central-1.amazonaws.com
# S3_CDN_URL=https://cdn.example.com  # опционально, если есть CloudFront
#
# --- DigitalOcean Spaces ---
# S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# S3_ACCESS_KEY=DO00...
# S3_SECRET_KEY=...
# S3_BUCKET=my-shop-media
# S3_REGION=fra1
# S3_PUBLIC_URL=https://my-shop-media.fra1.digitaloceanspaces.com
# S3_CDN_URL=https://my-shop-media.fra1.cdn.digitaloceanspaces.com
#
# --- Beget Cloud (ru) ---
# S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=...
# S3_REGION=ru1
# S3_PUBLIC_URL=https://s3.ru1.storage.beget.cloud/<BUCKET>
# S3_CDN_URL=https://<your-cdn>.begetcdn.cloud

# Email
# Driver: smtp (default) | resend | console (dev — печатает в логи без отправки)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="My Shop" <noreply@example.com>
# Если MAIL_DRIVER=resend:
# RESEND_API_KEY=re_...

# Brand (имя в email subject'ах, fallback в Settings)
BRAND_NAME=My Shop

# Контакты для legal pages (privacy/terms/consent placeholders)
SUPPORT_EMAIL=support@example.com
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_INN=
LEGAL_ENTITY_ADDRESS=

# Seed preset: generic-store (default, нейтральный) | fashion (с готовым каталогом одежды)
SEED_PRESET=generic-store

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Observability — Sentry (opt-in, по умолчанию выключен).
# Чтобы активировать:
#   1. pnpm add @sentry/node @sentry/profiling-node
#   2. Раскомментировать Sentry.init в server/src/sentry.bootstrap.ts
#   3. Задать SENTRY_DSN ниже
# SENTRY_DSN=https://xxx@sentry.io/...
# SENTRY_RELEASE=1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# OAuth (VK ID, Yandex ID)
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
OAUTH_STATE_EXPIRES=5m
OAUTH_SUCCESS_REDIRECT=http://localhost:3002/auth/callback
OAUTH_ERROR_REDIRECT=http://localhost:3002/login
OAUTH_LINK_SUCCESS_REDIRECT=http://localhost:3002/account/security

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_URL=http://localhost:4000/api/auth/vk/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:4000/api/auth/yandex/callback

# Payments
# `manual` provider всегда активен (заказ создаётся в PENDING — admin отмечает оплату вручную).
# Прочие активируются, когда заданы соответствующие credentials. На v1.0 шаблона
# yookassa/stripe/cloudpayments — stub-драйверы; реальная интеграция дописывается
# в server/src/modules/payments/drivers/.
#
# --- YooKassa (ru) ---
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
#
# --- Stripe (intl) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# --- CloudPayments (ru) ---
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=